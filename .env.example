# Configuration publique du SDK client Firebase (non sensible par conception —
# la protection réelle vient des Security Rules, voir FIREBASE_SECURITY.md).
# Les VRAIS secrets (compte de service Admin SDK, clés IA...) ne vont JAMAIS
# dans ce fichier : ils vivent uniquement dans la configuration des Cloud
# Functions (functions/.env ou Secret Manager), jamais dans le bundle client.
#
# Valeurs FICTIVES : copiez ce fichier en .env.local et remplacez-les par
# celles de votre projet (console Firebase > Paramètres du projet > Vos applis).

VITE_FIREBASE_API_KEY=AIzaSy-votre-cle-api-web
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://votre-projet-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=votre-projet
VITE_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# App Check (exigé par les fonctions de gestion des accès). Clé de site
# reCAPTCHA Enterprise — publique, à créer dans la console Firebase > App Check.
VITE_FIREBASE_APPCHECK_SITE_KEY=votre-cle-de-site-recaptcha-enterprise
# En local uniquement : active le jeton de débogage App Check.
VITE_FIREBASE_APPCHECK_DEBUG=false

# Tests en local avec les émulateurs Firebase (voir README « Tester en local »).
# true : le serveur de dev (npm run dev) se connecte aux émulateurs Auth,
# Database et Functions du projet fictif demo-uniflow, sans App Check ; les
# valeurs VITE_FIREBASE_* ci-dessus sont alors ignorées. Sans effet sur un
# build de production (npm run build).
VITE_USE_EMULATORS=false
