# Build hébergé de DÉMONSTRATION (npm run build:hosted, mode Vite « hosted »).
#
# Copiez ce fichier en .env.hosted (non versionné) et remplissez les valeurs
# avec la configuration web PUBLIQUE du projet de démo :
#   firebase apps:sdkconfig web <APP_ID> --project <ID_PROJET_DEMO>
# (liste des applications : firebase apps:list --project <ID_PROJET_DEMO>)
#
# Définissez TOUTES les clés, même vides : Vite charge aussi .env.local
# (votre configuration habituelle), et npm run build:hosted refuse de
# construire si une clé de .env.local manque ici.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Plan gratuit Spark : pas de Cloud Functions. L'interface masque les actions
# qui en dépendent (voir src/core/config/features.ts) et App Check, sans clé
# de site, n'est pas initialisé.
VITE_FUNCTIONS_ENABLED=false
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG=false
VITE_USE_EMULATORS=false
