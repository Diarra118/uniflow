{
  "name": "functions",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc -p tsconfig.test.json && node --test \"lib-test/test/**/*.test.js\"",
    "serve": "npm run build && firebase emulators:start --only functions,database,auth --project demo-uniflow",
    "deploy": "firebase deploy --only functions",
    "seed:emulators": "tsc -p tsconfig.test.json && node lib-test/scripts/seedEmulators.js",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 \"lib-test/test-integration/**/*.test.js\"",
    "build:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
