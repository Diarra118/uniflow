# Paramètres des Cloud Functions — VALEURS FICTIVES.
#
# Copiez ce fichier en `.env.<projectId>` (ex. .env.mon-projet) : la CLI le
# lit à chaque `firebase deploy`. Sans lui, la CLI demande les valeurs et
# crée ce fichier. Les fichiers .env.* (sauf celui-ci) sont exclus du dépôt
# (voir .gitignore).
#
# Les VRAIS secrets (clés de paiement, d'IA...) ne vont jamais ici :
# `firebase functions:secrets:set NOM` (Secret Manager).

# Clé API web Firebase — publique (même valeur que VITE_FIREBASE_API_KEY),
# utilisée pour l'envoi des invitations (accounts:sendOobCode).
WEB_API_KEY=AIzaSy-votre-cle-api-web

# Page de connexion vers laquelle renvoie l'email d'invitation. Le domaine
# doit figurer dans Authentication > Paramètres > Domaines autorisés.
APP_LOGIN_URL=https://votre-domaine.example/login

# Réservé aux phases suivantes (paiements, IA) — à définir via Secret Manager.
# STRIPE_SECRET_KEY=
# AI_PROVIDER_API_KEY=
