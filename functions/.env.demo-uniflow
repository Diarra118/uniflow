# Paramètres du projet FICTIF demo-uniflow, utilisé uniquement par les
# émulateurs (npm run emulators / npm run test:integration). Aucune valeur
# réelle : sous l'émulateur, l'invitation vise l'émulateur Auth et
# WEB_API_KEY n'est pas utilisée. Fichier versionné volontairement.
WEB_API_KEY=emulateur-cle-non-utilisee
APP_LOGIN_URL=http://localhost:5173/login
